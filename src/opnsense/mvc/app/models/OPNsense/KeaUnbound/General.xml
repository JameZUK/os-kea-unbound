<model>
    <mount>//OPNsense/KeaUnbound</mount>
    <description>Kea Unbound DDNS general settings</description>
    <version>0.0.1</version>
    <items>
        <general>
            <enabled type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </enabled>
            <qualifying_suffix type="HostnameField">
                <Required>N</Required>
                <IsDNSName>Y</IsDNSName>
                <description>Appended to bare hostnames to form FQDNs. Defaults to the firewall domain when left blank.</description>
            </qualifying_suffix>
            <listener_port type="PortField">
                <Default>53535</Default>
                <Required>Y</Required>
                <description>Loopback UDP port the DDNS listener binds to (kea-dhcp-ddns sends here).</description>
            </listener_port>
            <tsig_enabled type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
                <description>Authenticate DDNS updates between kea-dhcp-ddns and the listener with an auto-generated TSIG key.</description>
            </tsig_enabled>
            <tsig_algorithm type="OptionField">
                <Default>hmac-sha256</Default>
                <Required>Y</Required>
                <OptionValues>
                    <hmac-sha256>hmac-sha256</hmac-sha256>
                    <hmac-sha512>hmac-sha512</hmac-sha512>
                    <hmac-sha1>hmac-sha1</hmac-sha1>
                </OptionValues>
            </tsig_algorithm>
            <tsig_key_name type="TextField">
                <Default>keaunbound</Default>
                <Required>N</Required>
                <Mask>/^[0-9a-zA-Z._-]{0,64}$/u</Mask>
            </tsig_key_name>
            <tsig_key_secret type="TextField">
                <Required>N</Required>
                <Mask>/^[0-9a-zA-Z+\/=]{0,128}$/u</Mask>
                <description>Auto-generated base64 secret. Managed by the plugin; normally not edited by hand.</description>
            </tsig_key_secret>
            <aggressive_cleanup type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
                <description>On a new address for a host, remove older addresses Kea no longer recognises for that host.</description>
            </aggressive_cleanup>
            <update_on_renew type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
                <description>Re-assert a host's DNS records on every lease renewal, not just on a new/changed lease. More resilient (records self-repair on the next renewal) at the cost of more DDNS traffic on busy networks. Off = update only when a lease is new or its address changes.</description>
            </update_on_renew>
            <!-- internal bookkeeping (not shown in the form): set when THIS plugin
                 enabled Kea's DDNS daemon, so we revert it on disable/uninstall only
                 if it was off before we touched it. -->
            <manage_kea_ddns type="BooleanField">
                <Default>0</Default>
            </manage_kea_ddns>
        </general>
    </items>
</model>
